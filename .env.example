# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE
PORT=3000
MCP_SERVER_PORT=3001
NODE_ENV=development

# Live market data (optional). Get a free key at https://finnhub.io/register (no card required).
# Without this set, the backend falls back to the mock quotes in src/data/market-events.json and
# says so in its startup log and in the dashboard's "live" indicator — it does not fail or fake data.
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
